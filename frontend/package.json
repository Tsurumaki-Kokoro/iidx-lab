{
  "name": "iidxlab-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IIDX chart research with Vite, React and shadcn/ui",
  "packageManager": "npm@10.9.2",
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core.mjs",
    "./render": "./src/render.mjs",
    "./browse": "./src/browse.mjs"
  },
  "scripts": {
    "dev": "node build.cjs && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node build.cjs",
    "preview": "node preview.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node test-browse.cjs && node test-difficulty.cjs && node ../test.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
